     "rd": "이히 빈 민준.",
     "ko": "나는 민준이야."
    },
    {
     "tl": "Ich bin Student.",
     "rd": "이히 빈 슈투덴트.",
     "ko": "나는 학생이야."
    },
    {
     "tl": "Ich bin müde.",
     "rd": "이히 빈 뮈데.",
     "ko": "나는 피곤해."
    }
   ]
  },
  {
